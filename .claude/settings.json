{
  "permissions": {
    "deny": [
      "Edit(/.claude/**)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/.github/rulesets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }]
      }
    ]
  }
}
